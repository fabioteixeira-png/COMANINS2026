rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isInternalAccount() {
      return isSignedIn() && request.auth.token.accountType == 'internal';
    }

    function isClientAccount() {
      return isSignedIn() && request.auth.token.accountType == 'client';
    }

    function isAdministrator() {
      return isInternalAccount() && (
        request.auth.token.permissionLevel == 'Administrador' ||
        request.auth.token.role == 'Administrador' ||
        request.auth.token.role == 'Admin' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'master' ||
        request.auth.token.role == 'Diretor' ||
        request.auth.token.role == 'Diretoria'
      );
    }

    function isSignatureOwner(userId) {
      return isInternalAccount()
        && request.auth.token.portalUserId == userId;
    }

    function isValidSignatureImage() {
      return request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function isValidDeliveryImage() {
      return request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function isValidOperationalImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function isValidInventoryAttachment() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType != null
        && (
          request.resource.contentType.matches('image/(png|jpeg|webp|gif)') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'text/plain' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
          request.resource.contentType == 'application/vnd.ms-excel' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        );
    }

    // Assinaturas digitais dos técnicos.
    // Leitura: somente usuários autenticados (internos ou clientes).
    // Escrita: somente o próprio colaborador vinculado ao portalUserId.
    // Cada versão é imutável: não permitimos sobrescrita ou exclusão pelo cliente web.
    match /signatures/{userId}/{fileName} {
      allow read: if isInternalAccount() || isClientAccount();
      allow create: if isSignatureOwner(userId) && isValidSignatureImage();
      allow update, delete: if false;
    }

    // Evidências fotográficas da entrega vinculadas à Entrada de Material.
    // Somente contas internas podem criar/ler. Arquivos são imutáveis após upload;
    // exclusão física fica restrita ao Administrador.
    match /intake-deliveries/{intakeId}/{category}/{fileName} {
      allow read: if isInternalAccount();
      allow create: if isInternalAccount()
        && category in ['instruments', 'signed-form']
        && isValidDeliveryImage();
      allow update: if false;
      allow delete: if isAdministrator();
    }

    // Fotos operacionais novas passam a ser armazenadas como objetos imutáveis.
    // O Firestore mantém apenas URL/path; fotos legadas em Base64 continuam legíveis
    // durante a migração gradual e não são apagadas automaticamente.
    match /instrument-photos/{instrumentId}/{category}/{fileName} {
      allow read: if isInternalAccount();
      allow create: if isInternalAccount()
        && category in ['registration', 'calibrated']
        && isValidOperationalImage();
      allow update, delete: if false;
    }

    match /intake-entry-photos/{intakeId}/{fileName} {
      allow read: if isInternalAccount();
      allow create: if isInternalAccount() && isValidOperationalImage();
      allow update, delete: if false;
    }

    match /inventory-attachments/{userUid}/{category}/{fileName} {
      allow read: if isInternalAccount();
      allow create: if isInternalAccount()
        && request.auth.uid == userUid
        && category in ['item', 'transaction']
        && isValidInventoryAttachment();
      allow update, delete: if false;
    }

    // RH/Financeiro: objetos sensíveis nunca são entregues por URL pública nem
    // acessados diretamente pelo SDK do navegador. Upload/download passam pelo
    // backend autenticado, que usa Admin SDK e aplica autorização por finalidade.
    match /secure-documents/{allPaths=**} {
      allow read, write: if false;
    }

    // Nenhum outro caminho do Storage fica exposto por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
