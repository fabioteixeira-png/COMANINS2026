    (i) => i.status === "Disponível para Retirada",
  ).length;
  const countEntregue = instruments.filter(
    (i) => i.status === "Entregue",
  ).length;
  const countRnc = instruments.filter(
    (i) =>
      i.status === "Não Conforme" ||
      i.hasRnc ||
      rncReports.some((r: any) => r.instrumentId === i.id),
