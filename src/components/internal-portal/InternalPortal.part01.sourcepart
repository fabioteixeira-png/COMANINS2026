const compressImage = (
  file: File,
  maxWidth = 1000,
  maxHeight = 1000,
  quality = 0.72,
): Promise<string> => {
  return compressImageToWebResolution(file, maxWidth, maxHeight, quality);
};

const compressBase64Image = (
  base64Str: string,
  maxWidth = 1000,
  maxHeight = 1000,
  quality = 0.72,
): Promise<string> => {
  return compressBase64Helper(base64Str, maxWidth, maxHeight, quality);
};

const currentCalibrationDate = () => {
  const now = new Date();
  const localTime = new Date(now.getTime() - now.getTimezoneOffset() * 60_000);
  return localTime.toISOString().split("T")[0];
};

const normalizeIntakeNumber = (value: unknown): string =>
  String(value ?? "").trim().replace(/\s+/g, "").toUpperCase();

const resolveComaninsStandardPeriodicity = (tag: unknown): 3 | 6 | 12 | null => {
  const normalizedTag = String(tag || "").trim().toUpperCase();
  const match = normalizedTag.match(/(?:^|[^0-9])(03|3|06|6|12)\s*$/);
  if (!match) return null;
  const months = Number(match[1]);
  return months === 3 || months === 6 || months === 12 ? months : null;
};

const isComaninsBpcStandardInstrument = (
  instrument: any,
  clients: Client[],
): boolean => {
  if (!instrument) return false;
  const client = clients.find((item: any) => item.id === instrument.clientId);
  const normalizedClient = normalizeFieldServiceLookup(
    client?.name || (client as any)?.razaoSocial || "",
  );
  const normalizedTag = String(instrument.tag || "").trim().toUpperCase();

  return normalizedClient.startsWith("COMANINS") && /^BPC(?:[-/\s]|$)/i.test(normalizedTag);
};

const resolveCalibrationLabelData = (
  instrument: any,
  calibrationReports: any[],
  clients: Client[] = [],
): CalibrationLabelData | null => {
  if (!instrument) return null;

  const latestApprovedReport = calibrationReports
    .filter(
      (report: any) =>
        report.instrumentId === instrument.id &&
        report.approved === true &&
        report.isDeleted !== true,
    )
    .sort((a: any, b: any) =>
      String(b.date || b.createdAt || b.id || "").localeCompare(
        String(a.date || a.createdAt || a.id || ""),
      ),
    )[0];

  const certificateNumber = String(
    latestApprovedReport?.certNumber ||
      instrument.certificateNumber ||
      instrument.coma ||
      "",
  ).trim();
  const calibrationDate = String(
    latestApprovedReport?.date || instrument.lastCalibrationDate || "",
  ).trim();

  if (!certificateNumber || !calibrationDate) return null;

  const isComaninsStandard = isComaninsBpcStandardInstrument(instrument, clients);
  if (!isComaninsStandard) {
    return { certificateNumber, calibrationDate };
  }

  const periodicityMonths = resolveComaninsStandardPeriodicity(instrument.tag);
  if (!periodicityMonths) return null;

  const validityDate = calculateCalibrationValidityDate(
    calibrationDate,
    periodicityMonths,
  );
  if (!validityDate) return null;

  return {
    certificateNumber,
    calibrationDate,
    isComaninsStandard: true,
    clientTag: String(instrument.tag || "").trim().toUpperCase(),
    periodicityMonths,
    validityDate,
  };
};

