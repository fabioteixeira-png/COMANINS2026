rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isInternalAccount() {
      return request.auth != null && request.auth.token.accountType == 'internal';
    }

    function isClientAccount() {
      return request.auth != null &&
        request.auth.token.accountType == 'client' &&
        request.auth.token.clientId != null;
    }

    function isAdministrator() {
      return isInternalAccount() && (
        request.auth.token.accessProfileId == 'administrator' ||
        (request.auth.token.accessProfileId == null && (
          request.auth.token.permissionLevel == 'Administrador' ||
          request.auth.token.role == 'Administrador' ||
          request.auth.token.role == 'Admin' ||
          request.auth.token.role == 'admin' ||
          request.auth.token.role == 'master' ||
          request.auth.token.role == 'Diretor' ||
          request.auth.token.role == 'Diretoria'
        ))
      );
    }

    function legacyHasModule(moduleId) {
      return request.auth.token.accessProfileId == null && (
        (moduleId in ['dashboard', 'personal_documents', 'internal_communication']) ||
        (request.auth.token.permissionLevel in ['Padrão', 'Padrao'] &&
          moduleId in ['clients', 'material_intake', 'calibration', 'digital_signature', 'field_service', 'inventory', 'rental']) ||
        (request.auth.token.permissionLevel == 'Limitado' &&
          moduleId in ['dashboard', 'personal_documents', 'internal_communication']) ||
        (request.auth.token.permissionLevel in ['Recursos Humanos (RH)', 'Recursos Humanos', 'RH'] &&
          moduleId in ['hr', 'health_programs']) ||
        (request.auth.token.role in ['Recursos Humanos (RH)', 'Recursos Humanos', 'RH'] &&
          moduleId in ['hr', 'health_programs']) ||
        (request.auth.token.permissionLevel == 'Financeiro' && moduleId == 'finance') ||
        (request.auth.token.role == 'Financeiro' && moduleId == 'finance')
      );
    }

    function hasModule(moduleId) {
      return isAdministrator() || (
        isInternalAccount() && (
          (request.auth.token.allowedModules is list &&
            request.auth.token.allowedModules.hasAny([moduleId])) ||
          legacyHasModule(moduleId)
        )
      );
    }

    function hasAnyModule(moduleIds) {
      return isAdministrator() || (
        isInternalAccount() &&
        request.auth.token.allowedModules is list &&
        request.auth.token.allowedModules.hasAny(moduleIds)
      );
    }

    function hasEditModule(moduleId) {
      return isAdministrator() || (
        isInternalAccount() && (
          (request.auth.token.editableModules is list &&
            request.auth.token.editableModules.hasAny([moduleId])) ||
          // Compatibilidade durante o rollout: tokens antigos não possuem
          // editableModules e mantêm temporariamente o comportamento anterior.
          (request.auth.token.editableModules == null && hasModule(moduleId))
        )
      );
    }

    function isCalibrationScopedIntakeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'devolutionGeneratedAt',
        'devolutionGeneratedBy',
        'devolutionRows',
        'photoDevolution',
        'deliveryInstrumentPhotos',
        'deliveryFormPhotos',
        'deliveryFinalizedAt',
        'deliveryFinalizedBy',
        'deliveryLocked'
      ]);
    }

    function isRhAccount() {
      return hasModule('hr');
    }

    function isFinanceAccount() {
      return hasModule('finance');
    }

    function isRhEditor() {
      return hasEditModule('hr');
    }

    function isFinanceEditor() {
      return hasEditModule('finance');
    }

    function isOwnPortalUser() {
      return request.auth != null &&
        request.auth.token.email != null &&
        resource.data.username != null &&
        request.auth.token.email == resource.data.username + '@comanins.internal';
    }

    function isOwnEmployeeResource() {
      return isInternalAccount() &&
        request.auth.token.portalUserId != null && (
          resource.data.employeeId == request.auth.token.portalUserId ||
          resource.data.userId == request.auth.token.portalUserId ||
          (request.auth.token.username != null && resource.data.employeeId == request.auth.token.username) ||
          (request.auth.token.username != null && resource.data.userId == request.auth.token.username)
        );
    }

    function canManageRh() {
      return isAdministrator() || isRhAccount();
    }

    function canManagePayslips() {
      return isAdministrator() || isRhAccount() || isFinanceAccount();
    }

    function canManageFinance() {
      return isAdministrator() || isFinanceAccount();
    }

    function canEditRh() {
      return isAdministrator() || isRhEditor();
    }

    function canEditPayslips() {
      return isAdministrator() || isRhEditor() || isFinanceEditor();
    }

    function canEditFinance() {
      return isAdministrator() || isFinanceEditor();
    }

    // Campos de arquivamento são autoritativos e só podem ser escritos pelo
    // backend via Admin SDK. O navegador pode editar o conteúdo operacional,
    // mas não pode apagar/restaurar/manipular a trilha de preservação.
    function archiveFieldsUntouched() {
      return resource.data.get('isDeleted', false) != true &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isDeleted', 'deletedAt', 'deletedBy', 'deletedByUid'
        ]);
    }

    function archiveFieldsAbsentOnCreate() {
      return !request.resource.data.keys().hasAny([
        'isDeleted', 'deletedAt', 'deletedBy', 'deletedByUid'
      ]);
    }
    match /systemSettings/{documentId} {
      // Only presentation settings are public. Operational sequences/catalogs require login.
      allow read: if isInternalAccount() || documentId in ['customLogo', 'headerLogo', 'companyInfo', 'sitePhotos'];

      // Operational counters are written by normal internal workflows.
      allow write: if (documentId == 'certSequence' && hasEditModule('calibration')) ||
        (documentId == 'intakeSequence' && hasEditModule('material_intake')) ||
        (documentId == 'examTypes' && canEditRh()) ||
        (documentId == 'calibrationLogo' && isAdministrator() &&
          request.resource.data.keys().hasOnly(['url']) &&
          request.resource.data.url is string &&
          request.resource.data.url.size() <= 750000) ||
        (documentId in ['customLogo', 'headerLogo', 'companyInfo', 'sitePhotos', 'dropdownOptions'] && isAdministrator());
    }
    match /sitePhotos/{document=**} {
      allow read: if true;
      allow write: if isAdministrator();
    }
    match /contactMessages/{document=**} {
      // Public submissions are persisted by the rate-limited backend, never directly by browsers.
      allow create: if false;
      allow read, update, delete: if isInternalAccount();
    }
    match /portalUsers/{document=**} {
      // Admin/RH can read complete employee profiles. Ordinary internal accounts
      // can read only their own document directly; the cross-employee directory
      // is delivered by /api/internal/portal-users with sensitive fields removed.
      allow read: if canManageRh() || isOwnPortalUser();

      // Self-service updates are restricted to password-change state and digital
      // signature metadata. Role, permissionLevel, username, auth linkage and all
      // RH/financial fields cannot be changed by the employee through Firestore.
      allow update: if (
        isAdministrator() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'permissionLevel',
          'accessProfileId',
          'accessProfileName',
          'accessProfileVersion',
          'allowedModules',
          'editableModules',
          'accessProfileUpdatedAt',
          'accessProfileUpdatedBy'
        ])
      ) || (
        // RH can maintain HR data but cannot change identity, authorization,
        // forced-password state or another employee's digital signature.
        isRhEditor() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'username',
          'permissionLevel',
          'accessProfileId',
          'accessProfileName',
          'accessProfileVersion',
          'allowedModules',
          'editableModules',
          'accessProfileUpdatedAt',
          'accessProfileUpdatedBy',
          'authUid',
          'authEmail',
          'passwordChangeRequired',
          'mustChangePassword',
          'signaturePath',
          'signatureVersion',
          'signatureDate'
        ])
      ) || (
        isOwnPortalUser() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'passwordChangeRequired',
            'mustChangePassword'
          ]) || (
            hasEditModule('digital_signature') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'passwordChangeRequired',
              'mustChangePassword',
              'signaturePath',
              'signatureVersion',
              'signatureDate'
            ])
          )
        )
      );

      allow create, delete: if isAdministrator();
    }

    // Perfis de acesso são lidos e gravados somente pelo backend Admin SDK.
    // Isso impede que o navegador altere a própria autorização.
    match /accessProfiles/{document=**} {
      allow read, write: if false;
    }
    // Reserva imutável de números de Entrada. Criada no mesmo transaction do
    // savedIntake pelo Admin SDK; nunca exposta para escrita no navegador.
    match /intakeNumberLocks/{document=**} {
      allow read, write: if false;
    }
    match /clients/{clientId} {
      // Client master data is no longer public. Internal accounts can manage the
      // directory; a client account can read only its own company profile.
      allow read: if hasModule('clients') ||
        (isClientAccount() && request.auth.token.clientId == clientId);
      allow create, update, delete: if hasEditModule('clients');
    }

    // Credenciais do Portal do Cliente são mantidas em coleção exclusiva do servidor.
    // Firebase Admin ignora estas regras; nenhum navegador, inclusive cliente autenticado,
    // pode ler ou alterar o segredo criptografado.
    match /clientPortalCredentials/{document=**} {
      allow read, write: if false;
    }


    // Marcadores de migração são gravados exclusivamente pelo Firebase Admin.
    // Administradores podem consultar o status, mas nenhum navegador altera o estado.
    match /securityMigrations/{document=**} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Documentos individuais do colaborador: o próprio titular pode ler;
    // RH/Admin gerenciam inclusão, alteração e exclusão.
    match /employeeDocuments/{document=**} {
      allow read: if isOwnEmployeeResource() || canManageRh();
      allow create: if canEditRh();
      allow update: if canEditRh() && archiveFieldsUntouched();
      allow delete: if false;
    }

    // Exames ocupacionais e ASOs contêm dados sensíveis de saúde.
    // Exclusão física foi substituída por arquivamento via backend.
    match /medical_exams/{document=**} {
      allow read: if canManageRh();
      allow create: if canEditRh();
      allow update: if canEditRh() && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /employeeAsos/{document=**} {
      allow read: if canManageRh();
      allow create: if canEditRh();
      allow update: if canEditRh() && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /health_program_docs/{document=**} {
      allow read: if hasModule('health_programs');
      allow create: if hasEditModule('health_programs');
      allow update: if hasEditModule('health_programs') && archiveFieldsUntouched();
      allow delete: if false;
    }

    // Contra-cheques e documentos financeiros pessoais.
    // O colaborador lê apenas os próprios documentos e pode registrar somente
    // os campos de ciência/visualização. RH, Financeiro e Admin gerenciam o todo.
    match /payslips/{document=**} {
      allow read: if isOwnEmployeeResource() || canManagePayslips();
      allow create: if canEditPayslips();
      allow delete: if false;
      allow update: if (canEditPayslips() && archiveFieldsUntouched()) || (
        isOwnEmployeeResource() &&
        resource.data.get('isDeleted', false) != true &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'visualized',
          'visualizedAt',
          'visualizedIp',
          'visualizedUserAgent',
          'lgpdConsentAccepted',
          'lgpdConsentDate'
        ])
      );
    }

    // Dados operacionais exibidos no Portal do Cliente.
    // Clientes não consultam estas coleções diretamente: os dados passam por
    // /api/client-portal/data, que usa o UID autenticado para localizar o cliente
    // e filtra os registros no servidor. Isso evita que regras virem apenas
    // filtros visuais e impede consulta cruzada entre clientes.
    match /instruments/{instrumentId} {
      allow read: if hasModule('calibration');
      allow create: if hasEditModule('calibration');
      // A transição para Entregue é permitida; depois disso o cadastro se torna
      // imutável para preservar a rastreabilidade da devolução. Campos de
      // arquivamento só podem ser escritos pelo backend (Admin SDK).
      allow update: if hasEditModule('calibration')
        && resource.data.status != 'Entregue'
        // A ficha de registro representa o estado histórico de entrada do
        // instrumento e não pode ser alterada pelo navegador após a criação.
        && request.resource.data.get('registrationSnapshot', null) == resource.data.get('registrationSnapshot', null)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isDeleted', 'deletedAt', 'deletedBy', 'deletedByUid'
        ]);
      // Exclusão física foi substituída por arquivamento administrativo.
      allow delete: if false;
    }
    match /calibrationReports/{reportId} {
      allow read: if hasModule('calibration');
      allow create: if hasEditModule('calibration') && archiveFieldsAbsentOnCreate();
      // Certificados associados a instrumento já entregue não podem ser
      // regravados. Campos de arquivamento são exclusivos do backend.
      allow update: if hasEditModule('calibration')
        && archiveFieldsUntouched()
        && (
          resource.data.get('instrumentId', null) == null ||
          get(/databases/$(database)/documents/instruments/$(resource.data.instrumentId)).data.status != 'Entregue'
        );
      allow delete: if false;
    }
    match /savedIntakes/{intakeId} {
      allow read: if hasModule('material_intake') || hasModule('calibration');
      // Criação passa exclusivamente pelo backend transacional para garantir unicidade do Nº de Entrada.
      allow create: if false;

      // A entrada pode ser atualizada enquanto a entrega não foi finalizada.
      // A mesma gravação que conclui a entrega precisa conter as duas classes
      // de evidência e ativa o bloqueio imutável do registro.
      // material_intake=edit pode atualizar a guia operacional. calibration=edit,
      // sem material_intake=edit, fica estritamente limitado aos campos de
      // devolução/entrega utilizados pelo fluxo de calibração.
      allow update: if (
          hasEditModule('material_intake') ||
          (hasEditModule('calibration') && isCalibrationScopedIntakeUpdate())
        )
        && request.resource.data.numEntrada == resource.data.numEntrada
        && archiveFieldsUntouched()
        && resource.data.get('deliveryLocked', false) != true
        && resource.data.get('deliveryFinalizedAt', null) == null
        && (
          request.resource.data.get('deliveryFinalizedAt', null) == null ||
          (
            request.resource.data.get('deliveryLocked', false) == true &&
            request.resource.data.deliveryFinalizedAt is string &&
            request.resource.data.deliveryInstrumentPhotos is list &&
            request.resource.data.deliveryInstrumentPhotos.size() > 0 &&
            request.resource.data.deliveryFormPhotos is list &&
            request.resource.data.deliveryFormPhotos.size() > 0
          )
        );

      // Após a conclusão ninguém altera o documento, inclusive Administrador.
      // O registro é arquivado pelo backend e as evidências são preservadas.
      allow delete: if false;
    }
    match /rncReports/{rncId} {
      allow read: if hasModule('calibration') || hasModule('audit');
      allow create: if hasEditModule('calibration') && archiveFieldsAbsentOnCreate();
      allow update: if hasEditModule('calibration')
        && archiveFieldsUntouched()
        && (
          resource.data.get('instrumentId', null) == null ||
          get(/databases/$(database)/documents/instruments/$(resource.data.instrumentId)).data.status != 'Entregue'
        );
      allow delete: if false;
    }
    match /fieldServiceRecords/{recordId} {
      allow read: if hasModule('field_service');
      allow create: if hasEditModule('field_service');
      allow update: if hasEditModule('field_service') && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isDeleted', 'deletedAt', 'deletedBy', 'deletedByUid'
        ]) || isAdministrator()
      );
      // Sem exclusão física pelo portal. O Administrador arquiva pelo backend.
      allow delete: if false;
    }

    // Financeiro: acesso somente para Financeiro e Administradores.
    match /financeTransactions/{document=**} {
      allow read: if canManageFinance();
      allow create: if canEditFinance()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.get('paidAmount', 0) == 0
        && request.resource.data.get('openBalance', request.resource.data.amount) == request.resource.data.amount
        && request.resource.data.get('settlements', []).size() == 0
        && request.resource.data.status != 'pago'
        // Compatibilidade de rollout: clientes antigos que ainda não enviam
        // createdByUid continuam válidos; quando o campo existir, ele só pode
        // identificar o próprio usuário autenticado.
        && request.resource.data.get('createdByUid', request.auth.uid) == request.auth.uid;
      // Baixas (paidAmount/openBalance/settlements) são autoritativas no backend
      // transacional. O navegador pode editar os dados cadastrais do título,
      // mas não pode fabricar ou apagar histórico de pagamentos/recebimentos.
      allow update: if canEditFinance()
        && archiveFieldsUntouched()
        // A autoria de criação e a data original são imutáveis. O UID do
        // último editor, quando alterado, deve corresponder ao token atual.
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedByUid'])
          || request.resource.data.get('updatedByUid', '') == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'paidAmount', 'openBalance', 'settlements',
          'importFingerprint', 'importedAt', 'importedBy'
        ])
        && (resource.data.get('paidAmount', 0) == 0
          || request.resource.data.amount == resource.data.amount)
        && (request.resource.data.status != 'pago'
          || (request.resource.data.get('paidAmount', 0) == request.resource.data.amount
            && request.resource.data.get('openBalance', request.resource.data.amount) == 0));
      allow delete: if false;
    }
    match /financeContracts/{document=**} {
      allow read: if canManageFinance();
      allow create: if canEditFinance();
      allow update: if canEditFinance() && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /financeMeasurements/{document=**} {
      allow read: if canManageFinance();
      allow create: if canEditFinance();
      allow update: if canEditFinance() && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /financeBankAccounts/{document=**} {
      allow read: if canManageFinance();
      allow create: if canEditFinance();
      allow update: if canEditFinance() && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /financeCategories/{document=**} {
      allow read: if canManageFinance();
      allow create: if canEditFinance();
      allow update: if canEditFinance() && archiveFieldsUntouched();
      allow delete: if false;
    }

    // Central Financeira simplificada. Registros operacionais e itens de
    // conciliação são escritos exclusivamente pelo backend para manter
    // validação, integrações automáticas e trilha de auditoria atômicas.
    match /financeOperations/{document=**} {
      allow read: if canManageFinance();
      allow create, update, delete: if false;
    }
    match /financeBankStatementItems/{document=**} {
      allow read: if canManageFinance();
      allow create, update, delete: if false;
    }

    // Locação mensal de instrumentos. Cadastros simples de serviços/equipamentos
    // podem ser mantidos pelo perfil de Locação; contratos, movimentações, faturas
    // e lembretes são autoritativos no backend para preservar disponibilidade,
    // numeração, ciclos de 30 dias e integração financeira.
    match /rentalServices/{serviceId} {
      allow read: if hasModule('rental');
      allow create: if hasEditModule('rental')
        && request.resource.data.monthlyPrice is number
        && request.resource.data.monthlyPrice > 0
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid;
      allow update: if hasEditModule('rental')
        && request.resource.data.monthlyPrice is number
        && request.resource.data.monthlyPrice > 0
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }
    match /rentalAssets/{assetId} {
      allow read: if hasModule('rental');
      allow create: if hasEditModule('rental')
        && request.resource.data.assetCode is string
        && request.resource.data.assetCode.size() > 0
        && request.resource.data.status in ['disponivel', 'manutencao', 'inativo']
        && !request.resource.data.keys().hasAny(['currentRentalId'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid;
      allow update: if hasEditModule('rental')
        && resource.data.status != 'locado'
        && request.resource.data.status in ['disponivel', 'manutencao', 'inativo']
        && request.resource.data.assetCode is string
        && request.resource.data.assetCode.size() > 0
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && request.resource.data.get('currentRentalId', '') == resource.data.get('currentRentalId', '')
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }
    match /rentalContracts/{rentalId} {
      allow read: if hasModule('rental');
      allow create, update, delete: if false;
    }
    match /rentalInvoices/{invoiceId} {
      allow read: if hasModule('rental') || hasModule('finance');
      allow create, update, delete: if false;
    }
    match /rentalMovements/{movementId} {
      allow read: if hasModule('rental');
      allow create, update, delete: if false;
    }
    match /rentalNotificationLogs/{notificationId} {
      allow read, create, update, delete: if false;
    }

    // Remaining operational collections explicitly allowed to internal accounts.
    match /inventoryItems/{itemId} {
      // Cadastro, edição, saldo e arquivamento passam pelo backend para que
      // estoque + movimentação + auditoria sejam consistentes e atômicos.
      allow read: if hasModule('inventory');
      allow create, update, delete: if false;
    }
    match /inventoryTransactions/{transactionId} {
      // Movimentações são gravadas somente pelo backend em transação atômica.
      allow read: if hasModule('inventory');
      allow create, update, delete: if false;
    }
    match /systemAuditLogs/{auditId} {
      // Trilha autoritativa: escrita somente pelo Admin SDK do backend.
      allow read: if hasModule('audit');
      allow create, update, delete: if false;
    }
    match /referenceStandards/{document=**} {
      allow read: if hasModule('calibration') || hasModule('audit');
      allow create: if hasEditModule('calibration') && archiveFieldsAbsentOnCreate();
      allow update: if hasEditModule('calibration') && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /calibrationAuditLogs/{document=**} {
      allow read: if hasModule('calibration') || hasModule('audit');
      allow create: if hasEditModule('calibration') && archiveFieldsAbsentOnCreate();
      // Registros de tempo são append-only no navegador. O backend pode
      // arquivá-los com Admin SDK após autorização administrativa.
      allow update, delete: if false;
    }
    match /internal_tickets/{document=**} {
      allow read: if hasModule('internal_communication') || hasModule('internal_communication_management');
      allow create: if hasEditModule('internal_communication') && archiveFieldsAbsentOnCreate();
      allow update: if (hasEditModule('internal_communication') || hasEditModule('internal_communication_management'))
        && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /accessAuditLogs/{document=**} {
      allow read, create: if isInternalAccount();
      allow update: if false;
      allow delete: if false;
    }
    match /employeeBirthdays/{document=**} {
      allow read: if isInternalAccount();
      allow create: if canEditRh();
      allow update: if canEditRh() && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /trainings/{document=**} {
      allow read: if isInternalAccount();
      allow create: if canEditRh();
      allow update: if canEditRh() && archiveFieldsUntouched();
      allow delete: if false;
    }
    match /employeeTrainings/{document=**} {
      allow read: if isInternalAccount();
      allow create: if canEditRh();
      allow update: if canEditRh() && archiveFieldsUntouched();
      allow delete: if false;
    }

    // Final production posture: any collection not explicitly listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
