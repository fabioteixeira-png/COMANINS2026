rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isInternalAccount() {
      return request.auth != null && request.auth.token.accountType == 'internal';
    }

    function isClientAccount() {
      return request.auth != null &&
        request.auth.token.accountType == 'client' &&
        request.auth.token.clientId != null;
    }

    function isAdministrator() {
      return isInternalAccount() && (
        request.auth.token.permissionLevel == 'Administrador' ||
        request.auth.token.role == 'Administrador' ||
        request.auth.token.role == 'Admin' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'master' ||
        request.auth.token.role == 'Diretor' ||
        request.auth.token.role == 'Diretoria'
      );
    }

    function isRhAccount() {
      return isInternalAccount() && (
        request.auth.token.permissionLevel == 'Recursos Humanos (RH)' ||
        request.auth.token.role == 'Recursos Humanos (RH)' ||
        request.auth.token.role == 'Recursos Humanos' ||
        request.auth.token.role == 'RH'
      );
    }

    function isFinanceAccount() {
      return isInternalAccount() && (
        request.auth.token.permissionLevel == 'Financeiro' ||
        request.auth.token.role == 'Financeiro'
      );
    }

    function isOwnPortalUser() {
      return request.auth != null &&
        request.auth.token.email != null &&
        resource.data.username != null &&
        request.auth.token.email == resource.data.username + '@comanins.internal';
    }

    function isOwnEmployeeResource() {
      return isInternalAccount() &&
        request.auth.token.portalUserId != null && (
          resource.data.employeeId == request.auth.token.portalUserId ||
          resource.data.userId == request.auth.token.portalUserId ||
          (request.auth.token.username != null && resource.data.employeeId == request.auth.token.username) ||
          (request.auth.token.username != null && resource.data.userId == request.auth.token.username)
        );
    }

    function canManageRh() {
      return isAdministrator() || isRhAccount();
    }

    function canManagePayslips() {
      return isAdministrator() || isRhAccount() || isFinanceAccount();
    }

    function canManageFinance() {
      return isAdministrator() || isFinanceAccount();
    }
    match /systemSettings/{document=**} {
      allow read: if true;
      allow write: if isInternalAccount();
    }
    match /sitePhotos/{document=**} {
      allow read: if true;
      allow write: if isInternalAccount();
    }
    match /contactMessages/{document=**} {
      allow create: if true;
      allow read, update, delete: if isInternalAccount();
    }
    match /portalUsers/{document=**} {
      // Etapa 1D: remove leitura pública.
      // Leitura permanece disponível apenas para contas internas autenticadas.
      allow read: if isInternalAccount();
      // O próprio colaborador pode atualizar seu cadastro; criação/exclusão ficam restritas a administrador.
      allow update: if isOwnPortalUser() || isAdministrator();
      allow create, delete: if isAdministrator();
    }
    match /clients/{clientId} {
      // Client master data is no longer public. Internal accounts can manage the
      // directory; a client account can read only its own company profile.
      allow read: if isInternalAccount() ||
        (isClientAccount() && request.auth.token.clientId == clientId);
      allow create, update, delete: if isInternalAccount();
    }

    // Credenciais do Portal do Cliente são mantidas em coleção exclusiva do servidor.
    // Firebase Admin ignora estas regras; nenhum navegador, inclusive cliente autenticado,
    // pode ler ou alterar o segredo criptografado.
    match /clientPortalCredentials/{document=**} {
      allow read, write: if false;
    }

    // Documentos individuais do colaborador: o próprio titular pode ler;
    // RH/Admin gerenciam inclusão, alteração e exclusão.
    match /employeeDocuments/{document=**} {
      allow read: if isOwnEmployeeResource() || canManageRh();
      allow create, update, delete: if canManageRh();
    }

    // Exames ocupacionais e ASOs contêm dados sensíveis de saúde.
    match /medical_exams/{document=**} {
      allow read, write: if canManageRh();
    }
    match /employeeAsos/{document=**} {
      allow read, write: if canManageRh();
    }
    match /health_program_docs/{document=**} {
      allow read, write: if canManageRh();
    }

    // Contra-cheques e documentos financeiros pessoais.
    // O colaborador lê apenas os próprios documentos e pode registrar somente
    // os campos de ciência/visualização. RH, Financeiro e Admin gerenciam o todo.
    match /payslips/{document=**} {
      allow read: if isOwnEmployeeResource() || canManagePayslips();
      allow create, delete: if canManagePayslips();
      allow update: if canManagePayslips() || (
        isOwnEmployeeResource() &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'visualized',
          'visualizedAt',
          'visualizedIp',
          'visualizedUserAgent',
          'lgpdConsentAccepted',
          'lgpdConsentDate'
        ])
      );
    }

    // Dados operacionais exibidos no Portal do Cliente.
    // Clientes não consultam estas coleções diretamente: os dados passam por
    // /api/client-portal/data, que usa o UID autenticado para localizar o cliente
    // e filtra os registros no servidor. Isso evita que regras virem apenas
    // filtros visuais e impede consulta cruzada entre clientes.
    match /instruments/{document=**} {
      allow read, write: if isInternalAccount();
    }
    match /calibrationReports/{document=**} {
      allow read, write: if isInternalAccount();
    }
    match /savedIntakes/{document=**} {
      allow read, write: if isInternalAccount();
    }
    match /rncReports/{document=**} {
      allow read, write: if isInternalAccount();
    }
    match /fieldServiceRecords/{document=**} {
      allow read, write: if isInternalAccount();
    }

    // Financeiro: acesso somente para Financeiro e Administradores.
    match /financeTransactions/{document=**} {
      allow read, write: if canManageFinance();
    }
    match /financeContracts/{document=**} {
      allow read, write: if canManageFinance();
    }
    match /financeMeasurements/{document=**} {
      allow read, write: if canManageFinance();
    }
    match /financeBankAccounts/{document=**} {
      allow read, write: if canManageFinance();
    }
    match /financeCategories/{document=**} {
      allow read, write: if canManageFinance();
    }

    // Catch-all para módulos internos ainda não segmentados por função.
    // Contas de cliente não recebem acesso genérico a nenhuma coleção: o Portal
    // do Cliente consome somente os dados filtrados pelo servidor autenticado.
    match /{collection}/{document=**} {
      allow read, write: if isInternalAccount() &&
        collection != 'portalUsers' &&
        collection != 'clients' &&
        collection != 'clientPortalCredentials' &&
        collection != 'employeeDocuments' &&
        collection != 'medical_exams' &&
        collection != 'employeeAsos' &&
        collection != 'health_program_docs' &&
        collection != 'payslips' &&
        collection != 'financeTransactions' &&
        collection != 'financeContracts' &&
        collection != 'financeMeasurements' &&
        collection != 'financeBankAccounts' &&
        collection != 'financeCategories' &&
        collection != 'instruments' &&
        collection != 'calibrationReports' &&
        collection != 'savedIntakes' &&
        collection != 'rncReports' &&
        collection != 'fieldServiceRecords';
    }
  }
}